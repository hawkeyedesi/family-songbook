    {
      "id": "devanagari",
      "label": "संस्कृतम्",
      "lang": "sa",
      "title": "ललिताष्टोत्तरशतनामावलिः — रजताचलपाठः",
      "chapters": [
        {
          "id": "invocation",
          "title": "आरम्भः",
          "paragraphs": [
            "ओं ऐं ह्रीं श्रीम् ।"
          ]
        },
        {
          "id": "names",
          "title": "अष्टोत्तरशतनामावलिः",
          "paragraphs": [
            "रजताचलशृङ्गाग्रमध्यस्थायै नमो नमः ।",
            "हिमाचलमहावंशपावनायै नमो नमः ।",
