      "id": "kannada",
      "lang": "kn",
      "label": "ಕನ್ನಡ",
      "title": "ಶಾರದೇ ಶಾರದೇ",
      "chapters": [
        {
          "id": "main",
          "title": "ಶಾರದೇ ಶಾರದೇ",
          "paragraphs": [
            "ಶಾರದೇ ಶಾರದೇ ಜ್ಞಾನದಾಯಿಕೇ ।\nಶಾರದೇ ಶಾರದೇ ಶಾರದಾಮ್ಬಿಕೇ ॥",
            "ಪಾರ್ವತಿ ಭಗವತಿ ಭಕ್ತಿದಾಯಿಕೇ ।\nತುಙ್ಗಾತೀರೇ ಶೃಙ್ಗಗಿರಿ ಶಾರದಾಮ್ಬಿಕೇ ॥",
            "ಭಕ್ತಿದಾಯಿಕೇ ಜ್ಞಾನದಾಯಿಕೇ ಮೋಕ್ಷದಾಯಿಕೇ ।\nಶಾರದಾಮ್ಬಿಕೇ ॥"
          ]
        },
        {
          "id": "refrain",
          "title": "ಪುನರಾವರ್ತನಮ್",
          "paragraphs": [
            "ಶಾರದೇ ಶಾರದೇ ಜ್ಞಾನದಾಯಿಕೇ ।\nಶಾರದೇ ಶಾರದೇ ಶಾರದಾಮ್ಬಿಕೇ ॥"
          ]
        }
