    },
    {
      "id": "devanagari",
      "lang": "kn",
      "label": "देवनागरी",
      "title": "भाग्यद लक्ष्मी बारम्म",
      "chapters": [
        {
          "id": "pallavi",
          "title": "पल्लवि",
          "paragraphs": [
            "पल्लवि",
            "भाग्यदा लक्ष्मी बारम्मा",
            "नम्मम्म नी सौ-भाग्यदा लक्ष्मी बारम्मा ॥"
          ]
        },
        {
          "id": "charanam-1",
          "title": "चरण 1",
          "paragraphs": [
            "चरणं 1",
            "हॆज्जॆयॆ मेले हॆज्जॆय निक्कुत",
            "गॆज्जॆ काल्गला ध्वनिय तोरुत (माडुत)",
            "सज्जन साधू पूजॆय वेलॆगॆ",
            "मज्जिगॆयॊलगिन बॆण्णॆयन्तॆ ॥",
            "(भाग्यदा)"
          ]
        },
        {
          "id": "charanam-2",
          "title": "चरण 2",
          "paragraphs": [
            "चरणं 2",
            "कनकावृष्टिय करॆयुत बारे",
            "मनकामनॆया सिद्धिय तोरॆ ।",
            "दिनकरकोटी तेजदि हॊलॆयुव",
            "जनकरायना कुमारि बेग ॥",
            "(भाग्यदा)"
          ]
        },
        {
          "id": "charanam-3",
          "title": "चरण 3",
          "paragraphs": [
            "चरणं 3",
            "अत्तित्तलगदॆ भक्तर मनॆयलि",
            "नित्य महोत्सव नित्य सुमङ्गल ।",
            "सत्यव तोरुव साधु सज्जनर",
            "चित्तदि हॊलॆयुव पुत्थलि बॊम्बॆ ॥",
            "(भाग्यदा)"
          ]
        },
        {
          "id": "charanam-4",
          "title": "चरण 4",
          "paragraphs": [
            "चरणं 4",
            "सङ्ख्ये इल्लद भाग्यव कॊट्टु",
            "कङ्कण कैया तिरुवुत बारॆ ।",
            "कुङ्कुमाङ्कितॆ पङ्कज लोचनॆ",
            "वेङ्कट रमणन बिङ्कदराणी ॥",
            "(भाग्यदा)"
          ]
        },
        {
          "id": "charanam-5",
          "title": "चरण 5",
          "paragraphs": [
            "चरणं 5",
            "सक्करॆ तुप्पद कालुवॆहरिसि",
            "शुक्रवारदा पूजॆय वेलॆगॆ ।",
            "अक्करॆयुल्ल अलगिरि रङ्गनन",
            "चॊक्क पुरन्दर विठ्ठलन राणी ॥",
            "(भाग्यदा)"
          ]
        }
      ],
      "references": [
        {
          "label": "Vaidika Vignanam — देवनागरी",
          "url": "https://vignanam.org/devanagari/bhagyada-lakshmi-baramma.html"
        }
      ],
      "source_sha256": "89a2561eda767456ab39da618e8789a1a81cf7c881ae863d70df89ab26126692",
