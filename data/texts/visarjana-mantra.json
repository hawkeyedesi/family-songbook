    {
      "id": "roman",
      "label": "English (Roman)",
      "lang": "en",
      "title": "Visarjana Mantra — Udvasana",
      "chapters": [
        {
          "id": "vedic",
          "title": "Vedic mantras",
          "paragraphs": [
            "oṃ utti̍ṣṭha brahmaṇaspate deva̱yanta̍stvemahe ।\nupa̱ pra ya̍ntu ma̱rutaḥ̍ su̱dāna̍va̱ indra̍ prā̱śūrbha̍vā̱ sacā̍ ॥",
            "a̱bhyāra̱midadra̍yo̱ niṣi̍ktaṃ̱ puṣka̍re̱ madhu̍ ।\na̱va̱tasya̍ vi̱sarja̍ne ॥"
          ],
          "layout": "verses"
        },
        {
          "id": "closing",
          "title": "Closing — family book",
          "paragraphs": [
            "pūjāvasāne gacchatvaṃ punarāgamanāya ca ॥"
          ],
          "layout": "verses",
          "number_start": 3
        }
