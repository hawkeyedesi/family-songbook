    {
      "id": "kannada",
      "label": "ಕನ್ನಡ",
      "lang": "kn",
      "title": "ವಿಸರ್ಜನ ಮಂತ್ರ — ಉದ್ವಾಸನೆ",
      "chapters": [
        {
          "id": "vedic",
          "title": "ವೈದಿಕ ಮಂತ್ರಗಳು",
          "paragraphs": [
            "ಓಂ ಉತ್ತಿ॑ಷ್ಠ ಬ್ರಹ್ಮಣಸ್ಪತೇ ದೇವ॒ಯನ್ತ॑ಸ್ತ್ವೇಮಹೇ ।\nಉಪ॒ ಪ್ರ ಯ॑ನ್ತು ಮ॒ರುತಃ॑ ಸು॒ದಾನ॑ವ॒ ಇನ್ದ್ರ॑ ಪ್ರಾ॒ಶೂರ್ಭ॑ವಾ॒ ಸಚಾ॑ ॥",
            "ಅ॒ಭ್ಯಾರ॒ಮಿದದ್ರ॑ಯೋ॒ ನಿಷಿ॑ಕ್ತಂ॒ ಪುಷ್ಕ॑ರೇ॒ ಮಧು॑ ।\nಅ॒ವ॒ತಸ್ಯ॑ ವಿ॒ಸರ್ಜ॑ನೇ ॥"
          ],
          "layout": "verses"
        },
        {
          "id": "closing",
          "title": "ಸಮಾಪ್ತಿ — ಕುಟುಂಬದ ಪುಸ್ತಕ",
          "paragraphs": [
            "ಪೂಜಾವಸಾನೇ ಗಚ್ಛತ್ವಂ ಪುನರಾಗಮನಾಯ ಚ ॥"
          ],
          "layout": "verses",
          "number_start": 3
        }
      ],
      "references": [
        {
          "label": "Rigveda 1.40.1 — accent-marked source",
