    {
      "id": "devanagari",
      "label": "संस्कृतम्",
      "lang": "sa",
      "title": "विसर्जनमन्त्रः — उद्वासनम्",
      "chapters": [
        {
          "id": "vedic",
          "title": "वैदिकमन्त्रौ",
          "paragraphs": [
            "ॐ उत्ति॑ष्ठ ब्रह्मणस्पते देव॒यन्त॑स्त्वेमहे ।\nउप॒ प्र य॑न्तु म॒रुतः॑ सु॒दान॑व॒ इन्द्र॑ प्रा॒शूर्भ॑वा॒ सचा॑ ॥",
            "अ॒भ्यार॒मिदद्र॑यो॒ निषि॑क्तं॒ पुष्क॑रे॒ मधु॑ ।\nअ॒व॒तस्य॑ वि॒सर्ज॑ने ॥"
          ],
          "layout": "verses"
        },
        {
          "id": "closing",
          "title": "समापनम् — पारिवारिकपुस्तकात्",
          "paragraphs": [
            "पूजावसाने गच्छत्वं पुनरागमनाय च ॥"
          ],
          "layout": "verses",
          "number_start": 3
        }
      ],
